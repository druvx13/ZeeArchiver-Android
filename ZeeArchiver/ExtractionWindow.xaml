<Window x:Class="ZeeArchiver.ExtractionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extract Archive" Height="450" Width="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                  Text="Extract Archive" 
                  FontSize="24" 
                  FontWeight="Bold"
                  Margin="0,0,0,20"/>

        <!-- Archive Selection -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Archive File:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="ArchivePathTextBox" 
                        Grid.Column="0"
                        IsReadOnly="True"
                        Padding="8"
                        VerticalContentAlignment="Center"
                        Margin="0,0,10,0"/>
                <Button Name="SelectArchiveButton"
                       Grid.Column="1"
                       Content="Browse..."
                       Click="SelectArchiveButton_Click"
                       Padding="15,8"
                       MinWidth="100"/>
            </Grid>
        </StackPanel>

        <!-- Extraction Path Selection -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Extract To:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="ExtractionPathTextBox" 
                        Grid.Column="0"
                        IsReadOnly="True"
                        Padding="8"
                        VerticalContentAlignment="Center"
                        Margin="0,0,10,0"/>
                <Button Name="SelectExtractionPathButton"
                       Grid.Column="1"
                       Content="Browse..."
                       Click="SelectExtractionPathButton_Click"
                       Padding="15,8"
                       MinWidth="100"/>
            </Grid>
        </StackPanel>

        <!-- Progress Bar -->
        <ProgressBar Name="ProgressBar"
                    Grid.Row="3"
                    Height="20"
                    IsIndeterminate="True"
                    Visibility="Collapsed"
                    Margin="0,0,0,10"/>

        <!-- Status -->
        <TextBlock Name="StatusTextBlock"
                  Grid.Row="4"
                  Text=""
                  FontStyle="Italic"
                  Foreground="#666"
                  VerticalAlignment="Top"
                  Margin="0,10,0,0"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="5" 
                   Orientation="Horizontal" 
                   HorizontalAlignment="Right"
                   Margin="0,20,0,0">
            <Button Name="ExtractButton"
                   Content="Extract"
                   Click="ExtractButton_Click"
                   Style="{StaticResource StandardButtonStyle}"
                   Margin="0,0,10,0"/>
            <Button Name="CancelButton"
                   Content="Cancel"
                   Click="CancelButton_Click"
                   Padding="15,8"
                   MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>
