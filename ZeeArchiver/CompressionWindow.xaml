<Window x:Class="ZeeArchiver.CompressionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Archive" Height="550" Width="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                  Text="Create Archive" 
                  FontSize="24" 
                  FontWeight="Bold"
                  Margin="0,0,0,20"/>

        <!-- File Selection Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Name="SelectFilesButton"
                   Content="Add Files"
                   Click="SelectFilesButton_Click"
                   Padding="15,8"
                   MinWidth="100"
                   Margin="0,0,10,0"/>
            <Button Name="SelectFolderButton"
                   Content="Add Folder"
                   Click="SelectFolderButton_Click"
                   Padding="15,8"
                   MinWidth="100"
                   Margin="0,0,10,0"/>
            <Button Name="ClearFilesButton"
                   Content="Clear All"
                   Click="ClearFilesButton_Click"
                   Padding="15,8"
                   MinWidth="100"/>
        </StackPanel>

        <!-- Files List -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Selected Files:" FontWeight="SemiBold" Margin="0,0,0,5"/>
        </StackPanel>
        
        <Border Grid.Row="3" 
                BorderBrush="#ddd" 
                BorderThickness="1" 
                Margin="0,0,0,15">
            <ListBox Name="FilesListBox" 
                    MinHeight="150"
                    MaxHeight="200"/>
        </Border>

        <TextBlock Name="FileCountTextBlock"
                  Grid.Row="4"
                  Text="0 file(s) selected"
                  FontStyle="Italic"
                  Foreground="#666"
                  Margin="0,0,0,15"/>

        <!-- Compression Settings -->
        <Grid Grid.Row="5" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Format Selection -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Archive Format:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox Name="CompressionFormatComboBox" 
                         Padding="8"
                         VerticalContentAlignment="Center">
                    <ComboBoxItem Content="ZIP" IsSelected="True"/>
                    <ComboBoxItem Content="TAR"/>
                    <ComboBoxItem Content="TAR.GZ"/>
                    <ComboBoxItem Content="TAR.BZ2"/>
                </ComboBox>
            </StackPanel>

            <!-- Output Path -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Output Archive:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Name="OutputPathTextBox" 
                            Grid.Column="0"
                            IsReadOnly="True"
                            Padding="8"
                            VerticalContentAlignment="Center"
                            Margin="0,0,10,0"/>
                    <Button Name="SelectOutputButton"
                           Grid.Column="1"
                           Content="Browse..."
                           Click="SelectOutputButton_Click"
                           Padding="15,8"
                           MinWidth="100"/>
                </Grid>
            </StackPanel>

            <!-- Progress Bar -->
            <ProgressBar Name="ProgressBar"
                        Grid.Row="2"
                        Height="20"
                        IsIndeterminate="True"
                        Visibility="Collapsed"
                        Margin="0,0,0,10"/>
        </Grid>

        <!-- Status -->
        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Name="StatusTextBlock"
                      Grid.Row="0"
                      Text=""
                      FontStyle="Italic"
                      Foreground="#666"
                      Margin="0,0,0,10"/>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="1" 
                       Orientation="Horizontal" 
                       HorizontalAlignment="Right">
                <Button Name="CompressButton"
                       Content="Create Archive"
                       Click="CompressButton_Click"
                       Style="{StaticResource StandardButtonStyle}"
                       Margin="0,0,10,0"/>
                <Button Name="CancelButton"
                       Content="Cancel"
                       Click="CancelButton_Click"
                       Padding="15,8"
                       MinWidth="100"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
