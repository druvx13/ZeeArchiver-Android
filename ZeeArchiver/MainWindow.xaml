<Window x:Class="ZeeArchiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeeArchiver" Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Section -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20">
            <StackPanel>
                <TextBlock Text="ZeeArchiver" 
                          FontSize="32" 
                          FontWeight="Bold" 
                          Foreground="White"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Archive Manager for Windows" 
                          FontSize="14" 
                          Foreground="White"
                          HorizontalAlignment="Center"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <StackPanel Grid.Row="1" 
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center"
                   Margin="40">
            
            <!-- Extract Button -->
            <Button Name="ExtractButton" 
                   Click="ExtractButton_Click"
                   Style="{StaticResource MainActionButtonStyle}"
                   Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📦" FontSize="24" Margin="0,0,10,0"/>
                    <TextBlock Text="Extract Archive" FontSize="18"/>
                </StackPanel>
            </Button>

            <!-- Compress Button -->
            <Button Name="CompressButton" 
                   Click="CompressButton_Click"
                   Style="{StaticResource MainActionButtonStyle}"
                   Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📁" FontSize="24" Margin="0,0,10,0"/>
                    <TextBlock Text="Create Archive" FontSize="18"/>
                </StackPanel>
            </Button>

            <!-- About Button -->
            <Button Name="AboutButton" 
                   Click="AboutButton_Click"
                   Style="{StaticResource SecondaryButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ️" FontSize="20" Margin="0,0,10,0"/>
                    <TextBlock Text="About" FontSize="16"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#f5f5f5" Padding="10">
            <TextBlock Text="Copyright © 2025 Mahmoud Galal" 
                      HorizontalAlignment="Center"
                      FontSize="12"
                      Foreground="#666"/>
        </Border>
    </Grid>
</Window>
